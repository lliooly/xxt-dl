{
  "name": "xxt-dl",
  "version": "0.1.1",
  "description": "Download visible Chaoxing/Xuexitong assignments for personal review.",
  "license": "MIT",
  "author": {
    "name": "lliooly",
    "email": "70371454+lliooly@users.noreply.github.com"
  },
  "main": "dist/src/desktop/main.js",
  "desktopName": "xxt-dl",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:node --silent && npm run build:preload --silent && npm run build:next --silent",
    "build:node": "tsc -p tsconfig.node.json",
    "build:preload": "esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/src/desktop/preload.cjs",
    "build:next": "next build --webpack",
    "start": "npm run build:node --silent && node dist/src/cli.js",
    "desktop": "npm run build --silent && electron dist/src/desktop/main.js",
    "clean": "npm run build:node --silent && node dist/src/clean-output.js",
    "icons": "python3 scripts/generate-icons.py",
    "test": "npm run build:node --silent && node --test dist/test/*.test.js",
    "check": "tsc --noEmit",
    "pack": "npm run build --silent && electron-builder --dir",
    "dist": "npm run build --silent && electron-builder --x64 --publish never",
    "dist:mac": "npm run build --silent && electron-builder --mac dmg --x64 --publish never",
    "dist:win": "npm run build --silent && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build --silent && electron-builder --linux AppImage deb --x64 --publish never",
    "validate:release": "node scripts/validate-release-artifacts.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.2.0",
    "playwright": "^1.53.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3"
  }
}
