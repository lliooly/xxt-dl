  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:node --silent && npm run build:web --silent",
    "build:node": "node scripts/clean-dist.mjs && tsc -p tsconfig.node.json",
    "build:web": "next build --webpack",
    "dev": "next dev --webpack -H 127.0.0.1 -p 8263",
    "web": "next dev --webpack -H 127.0.0.1 -p 8263",
    "web:start": "next start -H 127.0.0.1 -p 8263",
    "start": "npm run build:node --silent && node dist/src/cli.js",
    "clean": "npm run build:node --silent && node dist/src/clean-output.js",
    "test": "npm run build:node --silent && node --test dist/test/*.test.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "playwright": "^1.53.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
